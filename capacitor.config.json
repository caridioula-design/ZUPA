{
  "appId": "ci.zupa.app",
  "appName": "ZUPA",
  "webDir": "www",
  "android": {
    "backgroundColor": "#E97234"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#E97234",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "backgroundColor": "#E97234",
      "style": "DARK",
      "overlaysWebView": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_zupa",
      "iconColor": "#E97234"
    }
  }
}